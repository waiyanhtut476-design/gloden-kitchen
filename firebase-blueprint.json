{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "A food item or drink offered at Golden Monstate Kitchen",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Burmese dish name",
          "maxLength": 100
        },
        "englishName": {
          "type": "string",
          "description": "English dish name",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Dish category",
          "enum": ["မုန့်ဟင်းခါး", "ဟင်း", "သုပ်", "ကြော်", "အချိုပွဲ", "သောက်စရာ"]
        },
        "price": {
          "type": "number",
          "description": "Dish price in Kyats"
        },
        "emoji": {
          "type": "string",
          "description": "Food representation emoji",
          "maxLength": 10
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional uploaded food photo Data URL or image link",
          "maxLength": 2097152
        },
        "description": {
          "type": "string",
          "description": "Ingredients and description",
          "maxLength": 500
        },
        "badge": {
          "type": "string",
          "description": "Special highlight badge",
          "maxLength": 50
        },
        "isPopular": {
          "type": "boolean",
          "description": "Popular dish tag"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": ["name", "category", "price", "emoji"]
    },
    "Order": {
      "title": "Order",
      "description": "A food order placed by a customer at Golden Monstate Kitchen",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string",
          "description": "Customer full name",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Customer contact phone number",
          "maxLength": 30
        },
        "orderType": {
          "type": "string",
          "description": "Delivery or pickup",
          "enum": ["delivery", "pickup"]
        },
        "address": {
          "type": "string",
          "description": "Delivery address",
          "maxLength": 300
        },
        "note": {
          "type": "string",
          "description": "Special cooking instructions or delivery notes",
          "maxLength": 300
        },
        "items": {
          "type": "array",
          "description": "List of ordered dishes and quantities"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total order price in Kyats"
        },
        "status": {
          "type": "string",
          "description": "Order fulfillment status",
          "enum": ["pending", "confirmed", "preparing", "delivered", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Order creation timestamp"
        },
        "orderNumber": {
          "type": "string",
          "description": "Short human-readable order code",
          "maxLength": 20
        }
      },
      "required": ["customerName", "phone", "orderType", "items", "totalAmount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/menuItems/{itemId}": {
      "schema": "MenuItem",
      "description": "Menu items available at Golden Monstate Kitchen"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Past and active customer orders for Golden Monstate Kitchen"
    }
  }
}
